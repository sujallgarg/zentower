# ==============================================================================
# STACK & BALANCE: ZEN TOWERS — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# Client-Safe Variables (.env — Vite Frontend)
# These are exposed to the client bundle via import.meta.env
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_URL=https://zentower.app

# ------------------------------------------------------------------------------
# Server-Only Secrets (Supabase Edge Functions)
# Set securely via: npx supabase secrets set KEY=VALUE
# NEVER expose these in client code (.env or src/)
# ------------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# DODO_PAYMENTS_API_KEY=dodo_live_... (or dodo_test_... for test mode)
# DODO_PAYMENTS_WEBHOOK_SECRET=whsec_...
# DODO_PAYMENTS_ENV=live_mode (options: live_mode | test_mode)
